rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid}/backups/{backup} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['createdAt','chunks','bytes','sha256','version','invoices','products','customers'])
        && request.resource.data.version == 1
        && request.resource.data.createdAt == request.time
        && request.resource.data.chunks is int && request.resource.data.chunks > 0 && request.resource.data.chunks <= 48
        && request.resource.data.bytes is int && request.resource.data.bytes > 0 && request.resource.data.bytes <= 6291456
        && request.resource.data.sha256 is string && request.resource.data.sha256.size() == 64;
      allow update, delete: if false;
      match /chunks/{chunk} {
        allow read: if owner(uid);
        allow create: if owner(uid)
          && existsAfter(/databases/$(database)/documents/users/$(uid)/backups/$(backup))
          && !exists(/databases/$(database)/documents/users/$(uid)/backups/$(backup))
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string && request.resource.data.data.size() <= 174764;
        allow update, delete: if false;
      }
    }
  }
}
